#include "./src/config.h"
#ifdef SIDEQUEST_MENU

#org @gText_SideQuestName_1
Oak's Request

#org @gText_SideQuestDesc_1
Professor Oak needs your\nhelp with his Pokédex.\nComplete every task!

#org @gText_SideQuestDoneDesc_1
Oak is thrilled with your\nresearch. Thank you!

#org @gText_SideQuestMap_1
Pallet Town

#org @gText_SideQuestName_2
Gym Challenge

#org @gText_SideQuestDesc_2
Defeat all eight Gym\nLeaders of Kanto and\nearn every badge.

#org @gText_SideQuestDoneDesc_2
All eight badges are yours.\nThe League awaits!

#org @gText_SideQuestMap_2
Kanto

#org @gText_SideQuestName_3
Parcel Delivery

#org @gText_SideQuestDesc_3
Pick up the parcel at the\nPoké Mart and bring it\nto Professor Oak.

#org @gText_SideQuestDoneDesc_3
The parcel reached Oak\nsafely. Nice work!

#org @gText_SideQuestMap_3
Viridian City

#org @gText_SideQuestName_4
Fossil Hunter

#org @gText_SideQuestDesc_4
Search Mt. Moon for an\nancient fossil and show\nit to the scientist.

#org @gText_SideQuestDoneDesc_4
The fossil has been\nrevived. Amazing!

#org @gText_SideQuestMap_4
Pewter City

#org @gText_SideQuestName_5
Ticket to Sea

#org @gText_SideQuestDesc_5
Get a ticket for the\nS.S. Anne and meet the\ncaptain on board.

#org @gText_SideQuestDoneDesc_5
You enjoyed the cruise\nand helped the captain.

#org @gText_SideQuestMap_5
Vermilion City

#org @gText_SideQuestName_6
Rocket Trouble

#org @gText_SideQuestDesc_6
Team Rocket hides below\nthe Game Corner.\nStop their plans!

#org @gText_SideQuestDoneDesc_6
Team Rocket's hideout\nhas been shut down.

#org @gText_SideQuestMap_6
Celadon City

#org @gText_SideQuestName_7
Power Plant Rumor

#org @gText_SideQuestDesc_7
Something is draining the\nPower Plant's energy.\nInvestigate it.

#org @gText_SideQuestDoneDesc_7
You found the cause: a\nlegendary bird!

#org @gText_SideQuestMap_7
Route 10

#org @gText_SideQuestName_8
Eevee's Gift

#org @gText_SideQuestDesc_8
A kind trainer gives away\na rare Eevee. Prove you\ncan raise it well.

#org @gText_SideQuestDoneDesc_8
Eevee has a loving\nnew home with you.

#org @gText_SideQuestMap_8
Celadon City

#org @gText_SideQuestName_9
Snorlax Blockade

#org @gText_SideQuestDesc_9
A huge Pokémon sleeps\non the road. Find a way\nto wake it up.

#org @gText_SideQuestDoneDesc_9
The road is open and\nSnorlax is gone.

#org @gText_SideQuestMap_9
Route 12

#org @gText_SideQuestName_10
Lost Teeth

#org @gText_SideQuestDesc_10
The Warden lost his teeth\nin the Safari Zone.\nFind them for him.

#org @gText_SideQuestDoneDesc_10
The Warden can speak\nclearly again!

#org @gText_SideQuestMap_10
Fuchsia City

#org @gText_SideQuestName_11
Fishing Master

#org @gText_SideQuestDesc_11
Prove your skill by\nreeling in Magikarp with\nevery rod.

#org @gText_SideQuestDoneDesc_11
You earned the Super Rod.\nGone fishing!

#org @gText_SideQuestMap_11
Vermilion City

#org @gText_SideQuestName_12
Cave of Legends

#org @gText_SideQuestDesc_12
Rumors tell of a mighty\nPokémon deep inside\nthe cave.

#org @gText_SideQuestDoneDesc_12
You have faced the\nlegend of Cerulean Cave.

#org @gText_SideQuestMap_12
Cerulean Cave

